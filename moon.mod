name = "moonbitstack/moonrpc"

version = "0.21.10"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonrpc"

license = "Apache-2.0"

keywords = [
  "grpc",
  "rpc",
  "protobuf",
  "protocol-buffers",
  "http2",
  "microservice",
  "streaming",
  "unary",
  "bidirectional-streaming",
  "interceptor",
  "load-balancing",
  "health-check",
  "reflection",
  "tls",
  "compression",
  "gzip",
  "deflate",
  "deadline",
  "retry",
  "keepalive",
  "annotations",
  "wasm",
  "moonbit",
]

description = "gRPC for MoonBit."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonbase@0.4.2",
  "moonbitstack/moonzip@0.3.4",
  "moonbitstack/moonhttp@0.15.3",
  "moonbitstack/moonurl@0.2.3",
  "moonbitstack/moonvar@0.2.0",
  "moonbitstack/moondate@0.1.0",
  "moonbitstack/moonward@0.2.0",
  "moonbitstack/moonast@0.2.3",
  "moonbitlang/parser@0.4.6",
  "moonbitstack/moonnet@0.1.8",
  "moonbitstack/moontls@0.9.12",
  "moonbitstack/mooncred@0.6.7",
  "moonbitstack/mooncrypt@0.4.8",
  "moonbitstack/moonseed@0.1.0",
}

source = "src"
