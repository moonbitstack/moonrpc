name = "moonbitstack/moonrpc"

version = "0.22.3"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonrpc"

license = "Apache-2.0"

keywords = [
  "grpc",
  "rpc",
  "protobuf",
  "protocol-buffers",
  "http2",
  "microservice",
  "streaming",
  "unary",
  "bidirectional-streaming",
  "interceptor",
  "load-balancing",
  "health-check",
  "reflection",
  "tls",
  "compression",
  "gzip",
  "deflate",
  "deadline",
  "retry",
  "keepalive",
  "annotations",
  "stats",
  "channelz",
  "service-config",
  "wait-for-ready",
  "interop",
  "thrift",
  "thrift-binary",
  "thrift-compact",
  "tcompactprotocol",
  "tframedtransport",
  "thrift-header",
  "theader",
  "oneway",
  "idl",
  "grpc-go",
  "trpc",
  "trpc-go",
  "trpc-python",
  "trpc-io",
  "typescript",
  "connect",
  "connect-protocol",
  "connectrpc",
  "conformance",
  "wasm",
  "moonbit",
]

description = "gRPC for MoonBit."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonbase@0.5.1",
  "moonbitstack/moonjson@0.5.1",
  "moonbitstack/moonproto@0.2.1",
  "moonbitstack/moonzip@0.4.1",
  "moonbitstack/moonhttp@0.16.1",
  "moonbitstack/moonurl@0.3.1",
  "moonbitstack/moonvar@0.3.1",
  "moonbitstack/moondate@0.2.1",
  "moonbitstack/moonward@0.3.1",
  "moonbitstack/moonast@0.3.2",
  "moonbitlang/parser@0.4.9",
  "moonbitstack/moonnet@0.2.2",
  "moonbitstack/moontls@0.10.2",
  "moonbitstack/mooncred@0.8.1",
  "moonbitstack/mooncrypt@0.5.2",
  "moonbitstack/moonseed@0.2.1",
}

source = "src"
