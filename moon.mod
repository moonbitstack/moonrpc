name = "moonbitstack/moonrpc"

version = "0.21.2"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonrpc"

license = "Apache-2.0"

keywords = [ "grpc", "rpc", "protobuf", "http2", "moonbit" ]

description = "gRPC for MoonBit."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonbase@0.4.0",
  "moonbitstack/moonzip@0.3.0",
  "moonbitstack/moonhttp@0.15.0",
  "moonbitstack/moonurl@0.2.0",
  "moonbitstack/moonvar@0.2.0",
  "moonbitstack/moondate@0.1.0",
  "moonbitstack/moonward@0.2.0",
  "moonbitstack/moonast@0.2.1",
  "moonbitlang/parser@0.4.6",
}

source = "src"
