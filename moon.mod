name = "moonbitstack/moonrpc"

version = "0.21.14"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonrpc"

license = "Apache-2.0"

keywords = [
  "grpc",
  "rpc",
  "protobuf",
  "protocol-buffers",
  "http2",
  "microservice",
  "streaming",
  "unary",
  "bidirectional-streaming",
  "interceptor",
  "load-balancing",
  "health-check",
  "reflection",
  "tls",
  "compression",
  "gzip",
  "deflate",
  "deadline",
  "retry",
  "keepalive",
  "annotations",
  "stats",
  "channelz",
  "service-config",
  "wait-for-ready",
  "interop",
  "thrift",
  "thrift-binary",
  "thrift-compact",
  "tcompactprotocol",
  "tframedtransport",
  "thrift-header",
  "theader",
  "oneway",
  "idl",
  "grpc-go",
  "wasm",
  "moonbit",
]

description = "gRPC for MoonBit."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonbase@0.4.4",
  "moonbitstack/moonproto@0.1.1",
  "moonbitstack/moonzip@0.3.8",
  "moonbitstack/moonhttp@0.15.10",
  "moonbitstack/moonurl@0.2.6",
  "moonbitstack/moonvar@0.2.2",
  "moonbitstack/moondate@0.1.6",
  "moonbitstack/moonward@0.2.3",
  "moonbitstack/moonast@0.2.7",
  "moonbitlang/parser@0.4.6",
  "moonbitstack/moonnet@0.1.12",
  "moonbitstack/moontls@0.9.16",
  "moonbitstack/mooncred@0.6.13",
  "moonbitstack/mooncrypt@0.4.14",
  "moonbitstack/moonseed@0.1.3",
}

source = "src"
