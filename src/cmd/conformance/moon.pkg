// Both halves of the Connect conformance suite, in one binary. Without an argument it is the
// reference server: announce the port it bound and serve until killed. With `client` it is the
// client under test: read one length-delimited request per case on stdin and answer each one.
import {
  "moonbitstack/moontls/tls",
  "moonbitstack/mooncred/x509",
  "moonbitstack/moonrpc/conformance" @reference,
  "moonbitstack/moonrpc/connect",
  "moonbitstack/moonrpc/net",
  "moonbitstack/moonrpc/proto",
  "moonbitstack/moonrpc/wire",
  "moonbitstack/moonjson",
  "moonbitstack/moonhttp/header",
  "moonbitlang/async",
  "moonbitlang/async/stdio",
  "moonbitlang/core/buffer",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

pkgtype(kind: "executable")

options(
  supported_targets: "native",
)
