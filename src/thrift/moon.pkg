// The Thrift binary protocol (TBinaryProtocol) and its framed transport, independent
// of gRPC: bytes in, bytes out, no HTTP/2 and no protobuf. The native driver lives in
// `net/`, the same way gRPC's does.
import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/double",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonbitstack/moonbase/base64",
  "moonbitstack/moonzip/zlib",
  "moonbitstack/moonvar/fixed",
}

import {
  "moonbitlang/async",
} for "wbtest"
