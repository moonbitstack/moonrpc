// moonrpc (<- gRPC): real gRPC over a self-built HTTP/2 (RFC 9113) and HPACK
// (RFC 7541), not gRPC-Web. The root re-exports every layer; each layer is a
// subpackage a program can import on its own.
import {
  "moonbitstack/moonrpc/wire",
  "moonbitstack/moonrpc/proto",
  "moonbitstack/moonrpc/stream",
  "moonbitstack/moonrpc/balance",
  "moonbitstack/moonrpc/client",
  "moonbitstack/moonrpc/server",
  "moonbitstack/moonrpc/service",
  "moonbitstack/moonhttp/header",
}

import {
  "moonbitstack/moonhttp/http2",
} for "wbtest"
